{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dakshmusic3",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",
  "assets": { "directory": "./web", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "dakshmusic3", "database_id": "3f384751-424c-4628-ac18-384c068afd8b" }],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "dakshmusic3-audio" }],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true },
    "traces": { "enabled": true, "persist": true, "head_sampling_rate": 1 }
  }
}
