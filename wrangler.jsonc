{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dakshmusic3-site",
  "main": "site-worker.js",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "COORDINATOR",
      "service": "dakshmusic3-coordinator"
    }
  ]
}
