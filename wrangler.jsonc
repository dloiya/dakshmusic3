{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dakshmusic3",
  "main": "backend/entry.py",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./frontend-react/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dakshmusic3",
      "database_id": "3f384751-424c-4628-ac18-384c068afd8b",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "dakshmusic3-audio"
    }
  ],
  "secrets": {
    "required": [
      "DAKSH_ENVIRONMENT",
      "DAKSH_ADMIN_PASSWORD",
      "DAKSH_SESSION_SECRET",
      "DAKSH_WORKER_CALLBACK_SECRET",
      "DAKSH_GITHUB_TOKEN",
      "DAKSH_CORS_ORIGINS"
    ]
  },
  "observability": {
    "enabled": true
  }
}
