{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dakshmusic3",
  "main": "backend/entry.py",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./frontend-react/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dakshmusic3",
      "database_id": "3f384751-424c-4628-ac18-384c068afd8b",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "dakshmusic3-audio"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "METADATA_QUEUE",
        "queue": "dakshmusic3-metadata"
      }
    ],
    "consumers": [
      {
        "queue": "dakshmusic3-metadata",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1
      }
    ]
  },
  "secrets": {
    "required": [
      "APP_SECRET",
      "CALLBACK_SECRET",
      "GITHUB_TOKEN",
      "PASSWORD_HASH",
      "PASSWORD_SALT"
    ]
  },
  "observability": {
    "enabled": true
  }
}
