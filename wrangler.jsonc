{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dakshmusic3-site",
  "main": "site-worker.js",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "services": [
    {
      "binding": "COORDINATOR",
      "service": "dakshmusic3-coordinator"
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
